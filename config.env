# Shared settings for every script in this repo.
# Values already set in the environment (e.g. CodeBuild env vars) win.
: "${AWS_REGION:=ap-south-2}"            # Asia Pacific (Hyderabad)
: "${APP_NAME:=fde-task-app}"
: "${UBUNTU_AMI_PARAM:=/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id}"
: "${UI_INSTANCE_TYPE:=t3.medium}"
: "${API_INSTANCE_TYPE:=t3.medium}"
: "${DB_INSTANCE_TYPE:=t3.medium}"
: "${ROOT_VOLUME_GB:=20}"
: "${DB_PASSWORD_PARAM:=/${APP_NAME}/db-password}"
: "${EC2_INSTANCE_PROFILE:=${APP_NAME}-ec2-profile}"
export AWS_REGION AWS_DEFAULT_REGION="$AWS_REGION" APP_NAME UBUNTU_AMI_PARAM \
       UI_INSTANCE_TYPE API_INSTANCE_TYPE DB_INSTANCE_TYPE ROOT_VOLUME_GB \
       DB_PASSWORD_PARAM EC2_INSTANCE_PROFILE
